{
  "version": 3,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native build (host arch, x86_64 or arm64)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "LLAMA_BUILD_TOOLS": "ON",
        "LLAMA_BUILD_EXAMPLES": "ON",
        "LLAMA_BUILD_COMMON": "ON",
        "LLAMA_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "rpi-cm4",
      "displayName": "Raspberry Pi CM4 (Cortex-A72) cross-compile",
      "binaryDir": "${sourceDir}/build-rpi-cm4",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_C_FLAGS": "-mcpu=cortex-a72",
        "CMAKE_CXX_FLAGS": "-mcpu=cortex-a72",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "ONLY",
        "CMAKE_BUILD_TYPE": "Release",
        "LLAMA_BUILD_TOOLS": "ON",
        "LLAMA_BUILD_EXAMPLES": "ON",
        "LLAMA_BUILD_COMMON": "ON",
        "LLAMA_BUILD_SERVER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "native",  "configurePreset": "native",  "configuration": "Release" },
    { "name": "rpi-cm4", "configurePreset": "rpi-cm4", "configuration": "Release" }
  ]
}
